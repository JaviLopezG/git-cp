




#!/usr/bin/env bash
# git-cp - Duplicates a file simulating historical commits from its source history

set -e

if [ "$#" -lt 2 ]; then
    echo "Usage: git cp <source_file> <target_file>"
    exit 1
fi

SRC_FILE="$1"
DST_FILE="$2"

if [ ! -f "$SRC_FILE" ]; then
    echo "Error: Source file '$SRC_FILE' does not exist."
    exit 1
fi

HISTORY=$(git log --follow --raw --no-abbrev --format="COMMIT|%H|%s" -- "$SRC_FILE" | \
awk '
/^COMMIT\|/ {
    sub(/^COMMIT\|/, "")
    idx = index($0, "|")
    hash = substr($0, 1, idx - 1)
    msg = substr($0, idx + 1)
}
/^:/ {
    mode = $2
    blob = $4
    status = $5
    if (status ~ /^R/) {
        old_path = $6
        printf "%s|%s|%s|%s|%s\n", hash, blob, mode, msg, old_path
    } else {
        printf "%s|%s|%s|%s\n", hash, blob, mode, msg
    }
}' | tac)

if [ -z "$HISTORY" ]; then
    echo "Error: No history found for '$SRC_FILE'."
    exit 1
fi

PARENT_COMMIT=$(git rev-parse HEAD)
CURRENT_TREE=""

while IFS="|" read -r COMMIT BLOB_HASH MODE ORIG_MSG; do
    OLD_PATH=""
    if [[ "$ORIG_MSG" == *"|"* ]]; then
        OLD_PATH="${ORIG_MSG##*|}"
        ORIG_MSG="${ORIG_MSG%|*}"
    fi

    if [ -n "$BLOB_HASH" ] && [ "$BLOB_HASH" != "0000000000000000000000000000000000000000" ]; then
        if [ -n "$CURRENT_TREE" ]; then
            git read-tree "$CURRENT_TREE"
        fi

        # If it was a rename, append a white space to the blob content to force a tree diff
        if [ -n "$OLD_PATH" ]; then
            BLOB_HASH=$( (git cat-file -p "$BLOB_HASH"; echo -n " ") | git hash-object -w --stdin )
        fi

        git update-index --add --cacheinfo "$MODE" "$BLOB_HASH" "$DST_FILE"

        CURRENT_TREE=$(git write-tree)

        COMMIT_MSG="git cp ($SRC_FILE -> $DST_FILE): $ORIG_MSG"
        PARENT_COMMIT=$(git commit-tree "$CURRENT_TREE" -p "$PARENT_COMMIT" -m "$COMMIT_MSG")
    fi
done <<< "$HISTORY"

git reset --hard "$PARENT_COMMIT"

echo "Successfully copied history of '$SRC_FILE' to '$DST_FILE'."

